{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noImplicitAny": true,
        "exactOptionalPropertyTypes": true,
        "noPropertyAccessFromIndexSignature": true,
        "allowJs": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["@types/node", "playwright"]
    },
    "include": [
        "tests/**/*.ts",
        "harness/**/*.ts",
        "unit-harness/**/*.ts",
        "scripts/**/*.mjs"
    ]
}
