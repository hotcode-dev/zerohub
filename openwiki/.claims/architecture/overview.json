    {
      "id": "claim_96c053cdb46a4bee82188877cdd6cbb6",
      "statement": "Hub creation on the Go server is performed through the atomic CreateHubIfAbsent primitive on zerohub.ZeroHub (run under a cross-mode collision lock), so concurrent create requests for the same hub ID collapse to a single hub: the race winner creates and the rest receive ErrHubAlreadyExists (surfaced as HTTP 409) instead of orphaning a hub.",
      "evidence": [
        {
          "resource": "repo://server/pkg/handler/claim_hub_for_create.go#L17-L41",
          "version": "repo-lines-v1:sha256:0df50966e728cd57dee498be7041584b96ca0552697e3f1393b4bfc57eacbf54:"
        },
