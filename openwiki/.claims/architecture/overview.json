    },
    {
      "id": "claim_81cb264281c3495a995af79297c2c7d4",
      "statement": "The client exposes a pluggable Topology interface (init + onPeerStatusChange) that decides per-peer how to set up data channels, media tracks, and who sends the offer; MeshTopology and SFUTopology are the two built-in implementations.",
      "evidence": [
