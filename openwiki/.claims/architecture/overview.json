    {
      "id": "claim_937b0d08bd3849b4b3ddd56a5664ca43",
      "statement": "The Go server entrypoint constructs three independent ZeroHub instances (static, random, IP hub modes) via a shared newZeroHubOrPanic constructor and passes them to the handler, so each hub mode is backed by its own hub registry; the never-expiring 'permanent' hubs live in the static instance (isPermanent=true) and are created out-of-band by an admin over plain HTTP (/v1/static-hubs/create) rather than as a fourth instance.",
      "evidence": [
        {
          "resource": "repo://server/cmd/server.go#L25-L29",
          "version": "repo-lines-v1:sha256:318897bae9dcb784e43f0c6bdd4586199ab1323063572b90d44ad24283129f73:"
        },
        {
          "resource": "repo://server/cmd/server.go#L39-L47",
