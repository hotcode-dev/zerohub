    {
      "id": "claim_ad2d5b16d6b245e3a8a62a28587ca8d6",
      "statement": "SDP offers and answers are exchanged as protobuf ClientMessage/ServerMessage frames over the signaling WebSocket, and ICE candidates are flushed to the wire after a waitIceCandidatesTimeout (default 2000 ms) instead of being held indefinitely.",
      "evidence": [
        {
          "resource": "repo://client/src/zeroHub.ts#L901-L956",
          "version": "repo-lines-v1:sha256:3aa9667674eaa2dc2a2f7eb92e754b88d071fa93ba677f8a394e05691213924a:"
        }
      ]
    },
    {
      "id": "claim_4bc725d0e12f4379ac5b0f092ffd5b66",
      "statement": "When a peer joins a hub, the hub assigns it a monotonically increasing numeric ID via an atomic counter, broadcasts a PeerJoinedMessage to existing peers, and sends the new peer a HubInfoMessage containing its own peer ID, hub metadata, and the existing peer roster; the join signal is marshaled before the peer is registered in storage, so a marshal failure is a no-op and never leaves a half-registered peer.",
      "evidence": [
        {
          "resource": "repo://server/pkg/hub/hub.go#L70-L107",
          "version": "repo-lines-v1:sha256:d33adcb3c4e73afa73f1bb759ba76426f5d59d436c2ebdf0790d85e6ab4c7743:"
        }
      ]
    },
    {
      "id": "claim_f7fafa749519416eb6ce4c151c5edb57",
      "statement": "Both hubs and the peers within them are stored behind a generic storage.Storage[T] interface (Add, GetAll, Get, Delete, IsEmpty) with in-memory and Gache backends, selected by the APP_HUB_STORAGE and APP_PEER_STORAGE config values.",
      "evidence": [
