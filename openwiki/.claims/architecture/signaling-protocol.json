    {
      "id": "claim_fc485b5fc851457b9c9fc2f63bbdf7e9",
      "statement": "The SDP offer/answer is sent exactly once: sendOffer/sendAnswer call the shared armSendOnIceReady helper, whose onicecandidate handler fires the send on the first candidate-less event (gathering complete) and a waitIceCandidatesTimeout (default 2000 ms) timer fires it as a fallback, guarded by a single isSent flag; in addition every individual ICE candidate (including those arriving after the SDP went out) is trickled to the remote peer via sendIceCandidateToWebsocket / SendIceCandidateMessage and applied with addIceCandidate on receipt.",
      "evidence": [
        {
          "resource": "repo://client/src/const.ts#L39-L51",
          "version": "repo-lines-v1:sha256:e72614d259fb4a38815534354c42033508ac162405fc723b4353d5ac23054b4f:"
        },
        {
