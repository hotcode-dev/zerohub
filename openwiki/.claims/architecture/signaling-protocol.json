        }
      ]
    },
    {
      "id": "claim_64deb4b4043c498d9ceed2e2532e332f",
      "statement": "ServerMessage is a protobuf oneof envelope with six variants: hub_info_message, peer_joined_message, peer_disconnected_message, offer_message, answer_message, and ice_candidate_message (relays a trickled ICE candidate to the target peer).",
      "evidence": [
