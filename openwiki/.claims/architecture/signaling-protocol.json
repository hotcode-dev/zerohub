        },
        {
          "resource": "repo://client/src/zeroHub.ts#L1753-L1761",
          "version": "repo-lines-v1:sha256:2c510799089eadb682b417cb906fd4bd6e55b41772dbcbaf3664659caab02ab7:"
        }
