    {
      "id": "claim_b7c8cd3abfc340d18ae8650a7ca05b08",
      "statement": "CheckAdminAuth compares the base64-decoded Authorization header against APP_CLIENT_SECRET using crypto/subtle.ConstantTimeCompare, which closes the timing side-channel that a plain non-constant-time string comparison would leave open; on failure it writes a 401 JSON body and returns errAdminUnauthorized so callers perform no state mutation after an auth failure.",
      "evidence": [
