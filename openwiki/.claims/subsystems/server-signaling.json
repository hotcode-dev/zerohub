    {
      "id": "claim_973b6aefbd374b2793b3dbf5ba1a17ff",
      "statement": "hub.AddPeer assigns a peer a monotonic numeric ID from an atomic counter, stores it in PeerStorage, broadcasts a PeerJoinedMessage to the other peers, and sends the new peer a HubInfoMessage.",
      "evidence": [
        {
          "resource": "repo://server/pkg/hub/hub.go#L68-L100",
