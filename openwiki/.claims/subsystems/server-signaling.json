        }
      ]
    },
    {
      "id": "claim_11d056afeae2482eb5555e3341dce77f",
      "statement": "Server configuration is loaded from .env via godotenv and unmarshaled with go-env; key vars are APP_HOST (default 0.0.0.0), APP_PORT (default 8080), APP_CLIENT_SECRET (required), APP_HUB_STORAGE/APP_PEER_STORAGE (default memory), and APP_TRUST_PROXY (default false).",
      "evidence": [
        {
          "resource": "repo://server/pkg/config/config.go#L28-L40",
          "version": "repo-lines-v1:sha256:db0b35d3b8b6e8ea8de056a900a7ad1369655fbb55ac3e3d0d66f213f4e689df:"
        }
      ]
    },
    {
      "id": "claim_a640bf52ab174bd5b1f73e249412edf5",
      "statement": "handler.NewHandler refuses to start when APP_CLIENT_SECRET is empty, because the admin endpoint would otherwise be open to unauthenticated requests.",
