    {
      "id": "claim_1691c225c3d04d68be98e26d64aafa7f",
      "statement": "sendOffer and sendAnswer merge per-call RTC options by spreading into a fresh local object ({ ...config.rtcOfferOptions, ...options }) inside the shared negotiateWithPeer helper instead of mutating the shared config, so call-site options cannot leak into the stored config.rtcOfferOptions.",
