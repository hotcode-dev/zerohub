    {
      "id": "claim_3d7994bff5cc4ef1aa3bd7aaf510d9a3",
      "statement": "All seven hub connection entrypoints (createHub, joinHub, joinOrCreateHub, joinOrCreateIPHub, joinIPHub, createRandomHub, joinRandomHub) funnel into the private openHubConnection helper, which stores supplied metadata, builds a URL from getWS(host, tls) with id/hubMetadata/peerMetadata query params, and calls connectToZeroHub.",
