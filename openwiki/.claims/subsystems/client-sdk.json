  "claims": [
    {
      "id": "claim_f8eee7b4d94d405e8ae1cd7638c1d8cf",
      "statement": "ZeroHubClient.reconnect re-checks the isDisconnected flag inside the async getZeroHubBackupHost().then callback (not just at entry) so a disconnect() called while the backup-host fetch is in flight does not resurrect the connection; it also aborts if the backup host equals the current host.",
      "evidence": [
        {
          "resource": "repo://client/src/zeroHub.ts#L261-L307",
          "version": "repo-lines-v1:sha256:4067695af778ed172afdeab084fa9c0c7c7d6f1417a4ddf512e9db9c8a332a5c:"
        }
      ]
    },
    {
      "id": "claim_4b0dc7e91368409180c96e9a923cf9e7",
      "statement": "ZeroHubClient.disconnect() sets isDisconnected, clears pending ICE timeouts, detaches all WebSocket handlers (so onclose does not auto-reconnect) and closes the socket with code 1000, then transitions every peer to Disconnected, closes each RTCPeerConnection, and empties the peers map; the client is reusable afterwards.",
      "evidence": [
        {
          "resource": "repo://client/src/zeroHub.ts#L599-L626",
          "version": "repo-lines-v1:sha256:123f246a80cccf388228a56954051a06aaf9650aabb54d96803654795db3eb54:"
        }
      ]
    },
    {
      "id": "claim_82a5551e89604d8aaaa4f2c8a8c72c42",
      "statement": "The WebSocket onclose handler interprets close codes: 1000 does nothing, 1001 (going away) reconnects to the host named in the close reason (the migration redirect), and 1006/1011 reconnect, while other codes fire onZeroHubError.",
      "evidence": [
        {
          "resource": "repo://client/src/zeroHub.ts#L553-L584",
          "version": "repo-lines-v1:sha256:cd5d82aa7499e609c1e00e9e4b912fbc672263974b32c44c1394f13388e8500a:"
        }
      ]
    },
    {
      "id": "claim_94fcb528042c4c2e97fadddc7328073e",
      "statement": "connectToZeroHub resets the manual-disconnect flag and clears stale ICE timeout handles, so a client that previously called disconnect() starts a clean reusable connection on any new entrypoint.",
      "evidence": [
        {
          "resource": "repo://client/src/zeroHub.ts#L521-L528",
