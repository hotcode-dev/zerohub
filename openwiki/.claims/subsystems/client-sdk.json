    {
      "id": "claim_fab1320d27cb4ee9b13d4d8609736414",
      "statement": "connectToZeroHub tears down any live WebSocket through the shared private closeActiveSocket helper before creating the new socket: the previous socket's onclose/onerror/onmessage/onopen handlers are nulled (so it cannot fire reconnect() and advance hostIndex a second time for one failure, or a spurious onZeroHubError), then it is closed with code 1000 and this.ws is cleared. The same helper is used by disconnect(), so a second connection entry-point call without disconnect() no longer leaks the previous WebSocket.",
      "evidence": [
        {
          "resource": "repo://client/src/zeroHub.ts#L609-L654",
          "version": "repo-lines-v1:sha256:0b72ed46159dd190e6e1ab72b71afdac4e462dafd62cdc4a6bed31f3cfb7a7a3:"
        },
