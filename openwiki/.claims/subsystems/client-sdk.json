  "claims": [
    {
      "id": "claim_f8eee7b4d94d405e8ae1cd7638c1d8cf",
      "statement": "ZeroHubClient.reconnect(currentURL, newHost?) is the single recovery entry point: aborts on isDisconnected or reconnectAbandoned; validates a 1001 redirect host via isWellFormedHost and updates host/hostIndex; on abnormal close runs same-host retry with exponential backoff (maxReconnectAttempts default 10, base 250ms × 2^n, ±20% jitter, capped 30s), then host failover (advance hostIndex), then wraparound to the first host bounded by maxReconnectRounds (default 2), and finally latches reconnectAbandoned and surfaces the terminal error via onZeroHubError.",
      "evidence": [
        {
          "resource": "repo://client/src/zeroHub.ts#L538-L744",
          "version": "repo-lines-v1:sha256:d96e6a2c3beaf3db8ac2386b8e39e62f42c59d7cb0ef25f1c3cac3188070c180:"
        }
      ]
    },
    {
      "id": "claim_4b0dc7e91368409180c96e9a923cf9e7",
      "statement": "ZeroHubClient.disconnect() sets isDisconnected, cancels the queued same-host retry timer, resets reconnectRound, clears all pending iceTimeouts and webRtcRecoveryTimeouts, calls the shared closeActiveSocket() helper (detaches handlers, closes with 1000), then transitions every peer to Disconnected via removePeer and empties the peers map; the client is reusable afterwards. connectToZeroHub also calls closeActiveSocket() and clears reconnectAbandoned before opening a new socket.",
      "evidence": [
        {
          "resource": "repo://client/src/zeroHub.ts#L1201-L1239",
          "version": "repo-lines-v1:sha256:782684a7c50f3a7f80cdad7052c7d8a5537f2ddce3a523b07396ffba4bed15ed:"
        },
        {
