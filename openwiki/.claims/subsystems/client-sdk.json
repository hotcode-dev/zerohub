        }
      ]
    },
    {
      "id": "claim_ea59de1b8139452d86d9932f2f146675",
      "statement": "With autoAnswer: false, the offerMessage branch does not call sendAnswer; it moves the peer to AnswerPending and then invokes the public onOffer(peer, offerSdp) callback (guarded on the peer existing in the peers map) so the application completes the exchange via sendAnswer(peer.id, offerSdp). With autoAcceptAnswer: false, the answerMessage branch likewise moves the peer to AcceptPending and invokes the public onAnswer(peer, answerSdp) callback so the application completes the exchange via acceptAnswer(peer.id, answerSdp).",
      "evidence": [
        {
          "resource": "repo://client/README.md",
          "version": "repo-file-v1:sha256:a949456799e12caf43d0928f40dc1f303d1d022c79195a123a4be8889ca0b8d5"
        },
