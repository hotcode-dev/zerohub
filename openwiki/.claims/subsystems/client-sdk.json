        }
      ]
    },
    {
      "id": "claim_cb1d17319f134e2d84b96a4ed0c5feda",
      "statement": "connectToZeroHub resets the manual-disconnect flag (isDisconnected = false), cancels any queued same-host retry timer, and clears the reconnectAbandoned latch before dialing, so a client that previously called disconnect() — or whose reconnection was exhausted — can be reused cleanly from any entry point. It deliberately does NOT reset the same-host attempt counter (the budget refills only when a connection is confirmed by hub info) and preserves pending ICE-candidate timeouts so an in-flight offer/answer send survives the reconnect.",
      "evidence": [
