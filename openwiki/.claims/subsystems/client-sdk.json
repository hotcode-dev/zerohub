        }
      ]
    },
    {
      "id": "claim_bb5769354e864cb2bc46833d98cc362e",
      "statement": "Peer creation and teardown are centralised in the shared addPeer and removePeer helpers: addPeer builds a Peer with a fresh RTCPeerConnection, parses metadata via safeParseJson, wires onconnectionstatechange / oniceconnectionstatechange (both schedule P2P-drop recovery via scheduleWebrtcRecovery on disconnected/failed), stores it, and marks it Pending. removePeer clears the peer's pending ICE-candidate fallback timer and P2P-drop recovery timer, closes the RTCPeerConnection, nulls the state handlers, and deletes the peer from the map (a no-op if already gone). These are shared by the hubInfoMessage, peerJoinedMessage, peerDisconnectedMessage, roster-prune, and disconnect paths.",
      "evidence": [
        {
          "resource": "repo://client/src/zeroHub.ts#L1122-L1154",
          "version": "repo-lines-v1:sha256:65f365d707c7fbe18363aa28f529f6b2a399024717b13fc47609658a5ad95af9:"
