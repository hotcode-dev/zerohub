    {
      "id": "claim_2b6a3e2ef22b4cc387020205c3a3370c",
      "statement": "The WebSocket onerror handler logs and fires onZeroHubError but does not call reconnect: per RFC 6455 a network failure fires error and then close with code 1006, and reconnecting in both handlers would advance hostIndex twice for a single failure (skipping two hosts); all reconnection is handled in onclose.",
      "evidence": [
        {
          "resource": "repo://client/src/zeroHub.ts#L545-L552",
          "version": "repo-lines-v1:sha256:d185ed3dc5fe82df3fb50161baca93df1edb59d081417444306692adbba42bce:"
        }
