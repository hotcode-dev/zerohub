APP_DOMAIN=
APP_CLIENT_SECRET=client_secret
# Only set APP_TRUST_PROXY=true when this server sits behind a reverse proxy
# that strips or replaces the X-Forwarded-For / X-Real-IP headers. The rate
# limiter then keys by the proxy-provided client IP; otherwise it keys by the
# (unspoofable) socket peer address. Leave unset/false unless you control the
# proxy — an untrusted hop could forge those headers and bypass rate limiting.
APP_TRUST_PROXY=false
# Comma-separated list of extra origins allowed to open signaling WebSockets.
# Default (unset): same-origin only — a request's Origin host must match the
# request Host, and requests without an Origin (non-browser clients) pass.
# Set this for web UIs served from a different origin, e.g.
# APP_ALLOWED_ORIGINS=https://ui.example.com
APP_ALLOWED_ORIGINS=
